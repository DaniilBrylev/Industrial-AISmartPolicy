# PostgreSQL (docker-compose service `db`)
POSTGRES_USER=aisec
POSTGRES_PASSWORD=aisec_secret_change_me
POSTGRES_DB=aisec_policy
POSTGRES_PORT=5432

# Backend — URL для подключения из контейнера backend к сервису db
DATABASE_URL=postgresql+psycopg2://aisec:aisec_secret_change_me@db:5432/aisec_policy

# Backend HTTP
BACKEND_PORT=8000

# OpenRouter (AI) — для app/services/ai_service.py
# Скопируйте в .env (файл .env в .gitignore). Не коммитьте реальные ключи;
# если ключ попал в git — отзовите его в панели OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_TIMEOUT_SECONDS=60
# OPENROUTER_MAX_INPUT_CHARS=16000

# Каталог для DOCX политик (generate-policy)
# POLICY_EXPORT_DIR=var/generated_policies

# Frontend (Vite) — URL API с точки зрения браузера пользователя
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173
